{
  "name": "@answerfield/studio-ui",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "out",
    "!out/**/*.map",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "af-source": "./src/index.ts",
      "default": "./out/index.js"
    },
    "./webview": {
      "af-source": "./src/webview.ts",
      "default": "./out/webview.js"
    },
    "./protocol": {
      "types": "./out/protocol.d.ts",
      "af-source": "./src/protocol.ts",
      "default": "./out/protocol.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@answerfield/bundle": "https://github.com/answerfield/af-format/releases/download/v0.1.0/answerfield-bundle-0.1.0.tgz",
    "@answerfield/expr": "https://github.com/answerfield/af-format/releases/download/v0.1.0/answerfield-expr-0.1.0.tgz",
    "@answerfield/runtime-core": "https://github.com/answerfield/af-runtime/releases/download/v0.1.0/answerfield-runtime-core-0.1.0.tgz",
    "@answerfield/runtime-wc": "https://github.com/answerfield/af-runtime/releases/download/v0.1.0/answerfield-runtime-wc-0.1.0.tgz",
    "@answerfield/practice": "https://github.com/answerfield/af-runtime/releases/download/v0.1.0/answerfield-practice-0.1.0.tgz",
    "@answerfield/designer": "0.1.1"
  },
  "devDependencies": {
    "@answerfield/compiler": "https://github.com/answerfield/af-language/releases/download/v0.1.0/answerfield-compiler-0.1.0.tgz",
    "@answerfield/language": "https://github.com/answerfield/af-language/releases/download/v0.1.0/answerfield-language-0.1.0.tgz",
    "happy-dom": "^21.0.1",
    "langium": "~4.4.0",
    "vitest": "^5.0.5",
    "vscode-languageserver-textdocument": "~1.0.13"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/answerfield/af-studio",
    "directory": "packages/studio-ui"
  }
}
