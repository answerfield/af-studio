// Station 2: Gleich viel wert

item lb_gleichwertig "Gleich viel" {
  page {
    p "Diese beiden Kreise zeigen gleich viel."
    row {
      Pie(parts: 2, filled: 1, label: "Kreis mit 2 Teilen, 1 gefärbt", width: 7em)
      Pie(parts: 4, filled: 2, label: "Kreis mit 4 Teilen, 2 gefärbt", width: 7em)
    }
    same = Choice(label: wording("Welche Brüche sind genauso viel wie 1/2? Wähle alle.", easy: "Welche Brüche sind die Hälfte? Wähle alle."),
                  options: ["2/4", "3/5", "4/8", "2/3", "5/10"], max: 5)
  }
}

coding lb_gleichwertig {
  same: codes(
    code(1, "richtig", score: 2, when: same == {"2/4", "4/8", "5/10"}, feedback: "Alles richtig! Oben steht immer die Hälfte von unten."),
    code(2, "teilweise", score: 1, when: size(same - {1, 3, 5}) == 0 and size(same) > 0,
         feedback: "Alle, die du gewählt hast, stimmen. Es gibt aber noch mehr."),
    otherwise: "Mindestens einer deiner Brüche ist nicht die Hälfte.",
    hints: ["Bei der Hälfte ist der Zähler genau halb so groß wie der Nenner.", "Prüfe 4/8: Ist 4 die Hälfte von 8?"],
    solution: "2/4, 4/8 und 5/10"
  )
}

item lb_kuerzen "Kürzen" {
  page {
    p "Beim Kürzen teilst du Zähler und Nenner durch dieselbe Zahl. Der Wert bleibt gleich."
    p { "Kürze 8/12 so weit wie möglich: " short = Gap(label: "gekürzter Bruch", width: 4em) }
  }
}

coding lb_kuerzen {
  short: codes(
    code(1, "richtig", score: 1, when: number(short) == 2/3 and is_reduced(short), feedback: "Genau: 8/12 = 2/3."),
    code(2, "nicht vollständig gekürzt", when: number(short) == 2/3,
         feedback: wording("Der Wert stimmt! Du kannst aber noch weiter kürzen.", easy: "Gut! Du kannst noch weiter kürzen.")),
    otherwise: "Dieser Bruch ist nicht gleich viel wie 8/12.",
    hints: ["8 und 12 kann man beide durch 4 teilen."],
    solution: "2/3"
  )
}

// Mit Parametern: Die Lern-App übt dieselbe Aufgabe mit neuen Zahlen („Neue Zahlen“). Jede Fassung erfüllt die
// Bedingung in versions: verschiedene Nenner bis 8, echte Brüche; in Leichter Sprache fehlt bei beiden Pizzen genau
// ein Stück, dann reicht der Vergleich der Stücke.
item lb_vergleich(mia: Int = 3, mia_parts: Int = 4, ben: Int = 2, ben_parts: Int = 3) "Was ist mehr?" {
  versions(when: mia_parts in 2 .. 8 and ben_parts in 2 .. 8 and mia in 1 .. 7 and ben in 1 .. 7
                 and mia < mia_parts and ben < ben_parts and mia_parts != ben_parts
                 and (not (easy_language in accommodations()) or (mia == mia_parts - 1 and ben == ben_parts - 1)))
  page {
    p { "Mia bekommt " mia "/" mia_parts " einer Pizza, Ben bekommt " ben "/" ben_parts " einer gleich großen Pizza." }
    row {
      Pie(parts: mia_parts, filled: mia, label: "Mias Pizza: {mia} von {mia_parts} Teilen", width: 7em)
      Pie(parts: ben_parts, filled: ben, label: "Bens Pizza: {ben} von {ben_parts} Teilen", width: 7em)
    }
    more = Choice(label: "Wer bekommt mehr?", options: ["Mia", "Ben", "Beide gleich viel"])
  }
}

// Vergleich über den gemeinsamen Nenner mia_parts * ben_parts: Mia hat mia * ben_parts Teile davon, Ben ben * mia_parts.
coding lb_vergleich {
  more: codes(
    code(1, "richtig", score: 1,
         when: more == (if mia * ben_parts > ben * mia_parts then {1} else if mia * ben_parts < ben * mia_parts then {2} else {3}),
         feedback: "Richtig: {mia}/{mia_parts} = " + mia * ben_parts + "/" + mia_parts * ben_parts + " und "
                   + "{ben}/{ben_parts} = " + ben * mia_parts + "/" + mia_parts * ben_parts + "."),
    code(2, "gleich", when: more == {"Beide gleich viel"},
         feedback: "Die Stücke sind verschieden groß – zähl nicht nur, vergleiche genau."),
    otherwise: "Schau dir an, wie viel bei jeder Pizza fehlt.",
    hints: [wording("Bring beide Brüche auf denselben Nenner: " + mia_parts * ben_parts + ".",
                    easy: "Bei Mia fehlt 1/{mia_parts}. Bei Ben fehlt 1/{ben_parts}. Wo fehlt weniger?")],
    solution: if mia * ben_parts > ben * mia_parts then "Mia" else if mia * ben_parts < ben * mia_parts then "Ben" else "Beide gleich viel"
  )
}
